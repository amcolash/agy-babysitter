[Unit]
Description=agy Babysitter Web Terminal Server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Github/agy-babysitter
Environment=NODE_ENV=production
Environment="PATH=%h/.gemini/antigravity-cli/bin:%h/.local/bin:%h/.local/share/mise/shims:%h/.cargo/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env node dist/server/server.js
KillMode=process
CPUSchedulingPolicy=other
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=4
ExecStopPost=-/usr/bin/pkill -9 -f "systemd-inhibit.*agy-babysitter"
ExecStopPost=-/usr/bin/pkill -9 -f "sleep infinity"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
