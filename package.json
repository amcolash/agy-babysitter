{
  "name": "agy-babysitter",
  "version": "1.0.0",
  "description": "Remote web terminal babysitter for agy with zellij session persistence",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"server,vite\" -c \"cyan,magenta\" \"node --watch src/server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node --check src/*.js src/routes/*.js src/client/*.js public/sw.js && vite build",
    "server": "node --watch src/server.js",
    "start": "node src/server.js",
    "stop": "pkill -f 'node.*src/server.js' 2>/dev/null || true",
    "restart": "pkill -f 'node.*src/server.js' 2>/dev/null || true; sleep 0.3; node src/server.js",
    "session": "zellij attach -c agy-main -- agy"
  },
  "keywords": [
    "antigravity",
    "agy",
    "zellij",
    "xterm",
    "babysitter"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
