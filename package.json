{
  "name": "agy-babysitter",
  "version": "1.0.0",
  "description": "Remote web terminal babysitter for agy with zellij session persistence",
  "main": "src/server.js",
  "bin": {
    "agyh": "./src/cli.js"
  },
  "type": "module",
  "scripts": {
    "build:client": "vite build",
    "build:server": "node scripts/build-server.js",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "check": "node --check src/*.js src/routes/*.js src/client/*.js && npm run build",
    "dev": "node --watch src/server.js",
    "start": "node dist/server/server.js",
    "stop": "systemctl --user stop agy-babysitter.service 2>/dev/null || pkill -f 'node.*server.js' 2>/dev/null || true",
    "restart": "node src/restart.js",
    "deploy": "npm run build && npm run restart",
    "status": "systemctl --user status agy-babysitter.service",
    "logs": "journalctl --user -u agy-babysitter -f",
    "session": "node src/cli.js",
    "service:install": "./systemd/install.sh",
    "service:uninstall": "./systemd/uninstall.sh"
  },
  "keywords": [
    "antigravity",
    "agy",
    "zellij",
    "xterm",
    "babysitter"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
